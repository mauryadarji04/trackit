@model CreateTicketViewModel
@{ ViewData["Title"] = "New ticket"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Log a ticket</h1>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" maxlength="200" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectId" class="form-label"></label>
                            <select asp-for="ProjectId" asp-items="Model.Projects" class="form-select">
                                <option value="0">Choose a project...</option>
                            </select>
                            <span asp-validation-for="ProjectId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Priority" class="form-label">Severity</label>
                            <select asp-for="Priority" class="form-select">
                                @foreach (var p in TicketPriority.All)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                            <div class="form-text">Critical 4h, High 24h, Medium 72h, Low 120h to resolve.</div>
                        </div>
                    </div>
                    <button class="btn btn-primary" type="submit">Create ticket</button>
                    <a class="btn btn-link" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
