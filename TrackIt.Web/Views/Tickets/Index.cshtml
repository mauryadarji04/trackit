@model TicketListViewModel
@{ ViewData["Title"] = "Tickets"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Tickets <span class="text-muted fs-6">(@Model.Result.TotalCount)</span></h1>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create">New ticket</a>
    }
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small mb-1" for="search">Search</label>
            <input id="search" name="search" value="@Model.Filter.Search" class="form-control form-control-sm" placeholder="Title or description" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="status">Status</label>
            <select id="status" name="status" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var s in TicketStatus.All)
                {
                    <option value="@s" selected="@(Model.Filter.Status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="priority">Priority</label>
            <select id="priority" name="priority" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var p in TicketPriority.All)
                {
                    <option value="@p" selected="@(Model.Filter.Priority == p)">@p</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="projectId">Project</label>
            <select id="projectId" name="projectId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var p in Model.Projects)
                {
                    <option value="@p.Value" selected="@(Model.Filter.ProjectId?.ToString() == p.Value)">@p.Text</option>
                }
            </select>
        </div>
        @if (Model.IsAdmin)
        {
            <div class="col-md-2">
                <label class="form-label small mb-1" for="assigneeId">Assignee</label>
                <select id="assigneeId" name="assigneeId" class="form-select form-select-sm">
                    <option value="">Anyone</option>
                    @foreach (var d in Model.Developers)
                    {
                        <option value="@d.Value" selected="@(Model.Filter.AssigneeId == d.Value)">@d.Text</option>
                    }
                </select>
            </div>
        }
        <div class="col-md-1 d-grid">
            <button class="btn btn-outline-primary btn-sm" type="submit">Filter</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th><th>Title</th><th>Project</th><th>Priority</th><th>Status</th>
                    <th>Assignee</th><th>Due</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model.Result.Items)
            {
                <tr>
                    <td class="text-muted">@t.TicketId</td>
                    <td><a asp-action="Details" asp-route-id="@t.TicketId">@t.Title</a></td>
                    <td>@t.ProjectName</td>
                    <td><span class="badge @UiHelpers.PriorityClass(t.Priority)">@t.Priority</span></td>
                    <td><span class="badge @UiHelpers.StatusClass(t.Status)">@t.Status</span></td>
                    <td>@(t.AssigneeName ?? "Unassigned")</td>
                    <td class="@(t.IsSlaBreached ? "sla-breach" : "")">
                        @UiHelpers.Stamp(t.DueAt)
                        @if (t.IsSlaBreached) { <span title="SLA breached">&#9888;</span> }
                    </td>
                </tr>
            }
            @if (!Model.Result.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No tickets match these filters.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    @await Html.PartialAsync("_Pager", (Model.Result.Page, Model.Result.TotalPages))
</div>
