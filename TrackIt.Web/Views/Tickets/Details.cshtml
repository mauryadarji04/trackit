@model TicketDetailsViewModel
@{
    var t = Model.Ticket;
    ViewData["Title"] = $"#{t.TicketId} {t.Title}";
}

<div class="mb-3">
    <a asp-action="Index" class="small">&larr; All tickets</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h1 class="h4">#@t.TicketId &middot; @t.Title</h1>
                    <span class="badge fs-6 @UiHelpers.StatusClass(t.Status)">@t.Status</span>
                </div>
                <p class="ticket-description mt-3 mb-0">@t.Description</p>
            </div>
        </div>

        <div class="card mb-4" id="comments">
            <div class="card-header bg-white fw-semibold">Comments</div>
            <div class="card-body">
                @if (Model.Comments.Count == 0)
                {
                    <p class="text-muted">No comments yet.</p>
                }
                @foreach (var c in Model.Comments)
                {
                    <partial name="_Comment" model="c" />
                }

                <hr />
                <form asp-action="AddComment" asp-route-id="@t.TicketId" method="post">
                    <label class="form-label small" for="newComment">Add a comment</label>
                    <textarea id="newComment" name="text" class="form-control mb-2" rows="3" maxlength="2000" required></textarea>
                    <button class="btn btn-primary btn-sm" type="submit">Post comment</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white fw-semibold">History</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>When</th><th>Who</th><th>Change</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model.Audit)
                    {
                        <tr>
                            <td>@UiHelpers.Stamp(a.ChangedAt)</td>
                            <td>@(a.ChangedByName ?? "System")</td>
                            <td>
                                @if (a.OldStatus != a.NewStatus)
                                {
                                    <span>Status: @a.OldStatus &rarr; <strong>@a.NewStatus</strong></span>
                                }
                                @if (a.OldAssigneeName != a.NewAssigneeName)
                                {
                                    <span>Assignee: @(a.OldAssigneeName ?? "nobody") &rarr; <strong>@(a.NewAssigneeName ?? "nobody")</strong></span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Audit.Count == 0)
                    {
                        <tr><td colspan="3" class="text-muted text-center py-3">No changes yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-body">
                <dl class="mb-0 small">
                    <dt>Project</dt><dd>@t.ProjectName</dd>
                    <dt>Priority</dt><dd><span class="badge @UiHelpers.PriorityClass(t.Priority)">@t.Priority</span></dd>
                    <dt>Reporter</dt><dd>@t.ReporterName</dd>
                    <dt>Assignee</dt><dd>@(t.AssigneeName ?? "Unassigned")</dd>
                    <dt>Created</dt><dd>@UiHelpers.Stamp(t.CreatedAt)</dd>
                    <dt>Due (SLA)</dt>
                    <dd class="@(t.IsSlaBreached ? "sla-breach" : "")">
                        @UiHelpers.Stamp(t.DueAt) @if (t.IsSlaBreached) { <span>&mdash; breached</span> }
                    </dd>
                    <dt>Resolved</dt><dd class="mb-0">@UiHelpers.Stamp(t.ResolvedAt)</dd>
                </dl>
            </div>
        </div>

        @if (Model.NextStatuses.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header bg-white fw-semibold">Change status</div>
                <div class="card-body d-grid gap-2">
                    @foreach (var s in Model.NextStatuses)
                    {
                        <form asp-action="ChangeStatus" asp-route-id="@t.TicketId" method="post">
                            <input type="hidden" name="status" value="@s" />
                            <button class="btn btn-outline-primary w-100" type="submit">Move to @s</button>
                        </form>
                    }
                </div>
            </div>
        }

        @if (Model.CanAssign)
        {
            <div class="card">
                <div class="card-header bg-white fw-semibold">Assign</div>
                <div class="card-body">
                    <form asp-action="Assign" asp-route-id="@t.TicketId" method="post">
                        <select name="assigneeId" class="form-select mb-2" required>
                            <option value="">Choose a developer...</option>
                            @foreach (var d in Model.Developers)
                            {
                                <option value="@d.Value" selected="@(d.Value == t.AssigneeId)">@d.Text</option>
                            }
                        </select>
                        <button class="btn btn-primary w-100" type="submit">Assign</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
