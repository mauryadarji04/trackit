@model string
@{ ViewData["Title"] = "Error"; }

<div class="text-center py-5">
    <h1 class="h3">Something went wrong</h1>
    <p class="text-muted">The error has been logged. Reference: <code>@Model</code></p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go home</a>
</div>
