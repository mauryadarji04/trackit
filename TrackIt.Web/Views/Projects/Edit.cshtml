@model ProjectFormViewModel
@{ ViewData["Title"] = Model.ProjectId == 0 ? "New project" : "Edit project"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">@ViewData["Title"]</h1>
                <form asp-action="Save" method="post">
                    <input type="hidden" asp-for="ProjectId" />
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active (new tickets can be logged against it)</label>
                    </div>
                    <button class="btn btn-primary" type="submit">Save</button>
                    <a class="btn btn-link" asp-action="Index">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
