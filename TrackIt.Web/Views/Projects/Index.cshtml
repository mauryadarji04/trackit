@model IReadOnlyList<TrackIt.Core.Entities.Project>
@{ ViewData["Title"] = "Projects"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Projects</h1>
    <a class="btn btn-primary" asp-action="Create">New project</a>
</div>

<div class="card">
    <table class="table mb-0">
        <thead class="table-light"><tr><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td class="text-muted">@p.Description</td>
                <td>
                    @if (p.IsActive) { <span class="badge text-bg-success">Active</span> }
                    else { <span class="badge text-bg-secondary">Inactive</span> }
                </td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.ProjectId">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
